# Copy to .env (never commit .env). All keys are optional - the pipeline runs with VieNeu (local TTS) and no API at all;
# OPENAI_API_KEY only enables word-level caption alignment (whisper-1) and the 2nd-ASR pronunciation check.
OPENAI_API_KEY=
# Optional: Gemini TTS instead of VieNeu (needs a key with billing; free tier returned 429 in the reference case)
GEMINI_API_KEY=
# Path to the python.exe of the VieNeu-TTS virtualenv (Windows example: C:/tools/vieneu-tts/.venv/Scripts/python.exe)
VIENEU_PY=
