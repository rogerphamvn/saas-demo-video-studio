 },
 "privacy": {
  "_doc": "clean_js.py inlines this into js/sdv-clean.template.js. Regexes are JavaScript regex source strings.",
  "label": "ProfitBase Demo",
  "hide_visibility": [
   "[aria-label=\"Mở P&L AI Agent\"]",
   "button.fixed.bottom-6.right-6",
   "[data-sonner-toaster]"
  ],
  "hide_selectors": [
   "aside a[href=\"/logic-map\"]",
   "aside a[href=\"/system-architecture\"]",
   "aside a[href=\"/access-map\"]",
   "aside a[href=\"/policy-pulse\"]",
   "aside a[href^=\"/admin\"]"
  ],
  "mask_selectors": [
   "aside a[href=\"/profile\"]"
  ],
  "hide_groups": [
   {
    "root": "aside",
    "leaf_re": "^\\s*admin dashboard\\s*$",
    "flags": "i",
    "closest": "li"
   }
  ],
  "hide_leaf_text": [
   "^\\s*NEW\\s*$",
   "^Phase 1: chat"
  ],
  "replace_text": [
   {
    "re": "\\s*[•·]\\s*Claude Opus[\\s\\d.]*",
    "with": ""
   }
  ],
  "split_text": [
   {
    "container": "h1,h2,h3,p",
    "starts_re": "^\\s*Chào buổi",
    "after_re": ",\\s*$"
   }
  ],
  "old_names_re": "Old item name A|Old item name B|Test 1",
  "keep_re": "Demo ·",
  "old_rows": [
   {
    "root": "main",
    "leaf_re": "^\\s*Batch \"",
    "closest": "div.group"
   }
  ],
  "routes": [
   {
    "path_prefix": "/boms",
    "hide_rows": {
     "selector": "main tbody tr",
     "keep_re": "^\\s*Demo ·"
    },
    "hide_blocks": {
     "root": "main",
     "leaf_re": "^\\s*Định mức — ",
     "container_class_re": "space-y-3"
    },
    "listbox": {
     "trigger_text_re": "Chọn nguyên liệu",
     "in_dialog": true,
     "keep_re": "^\\s*Demo ·"
    }
   }
  ]
 },
